# LinkedIn Dashboard — Environment Variables

# ==========================================
# Frontend Configuration
# ==========================================

# Internal API secret key (must match the automation backend)
API_SECRET=

# API server base URL for the frontend BFF (server-side).
# Use http://localhost:3001 for local dev, or http://worker:3001 in Docker.
API_URL=http://localhost:3001

# Optional public WebSocket origin for real-time updates.
# Leave blank to use the same origin as the dashboard page.
# For local dev you can use http://localhost:3001.
NEXT_PUBLIC_WS_URL=

# Optional: bearer token required by Next.js API routes
API_ROUTE_AUTH_TOKEN=

# ==========================================
# Dashboard Authentication (NEW)
# ==========================================

# Dashboard login password (plaintext, use strong random string)
# Generate with: openssl rand -base64 32
DASHBOARD_PASSWORD=

# JWT signing secret (min 32 chars for HS256)
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Dashboard session duration in seconds (2592000 = 30 days)
SESSION_MAX_AGE=2592000

# Brute-force protection for /api/auth/login (per client IP).
LOGIN_RATE_MAX_ATTEMPTS=10
LOGIN_RATE_WINDOW_SECONDS=900

# Self-registration is DISABLED unless set to 1. The dashboard uses a single
# shared DASHBOARD_PASSWORD; leave this unset in normal deployments.
ALLOW_REGISTRATION=0

# ==========================================
# Worker Configuration
# ==========================================

# Encryption key for session cookies (AES-256-GCM, must be 64 hex chars / 32 bytes)
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# LinkedIn account session TTL in Redis (days)
SESSION_TTL_DAYS=30
BROWSER_USE_SYSTEM_CHROME=1
# Keep headless=0 — headless Chrome is fingerprinted and blocked by LinkedIn.
BROWSER_HEADLESS=0
# Sync cadence (minutes). Defaults match docker-compose; higher = more human-like.
SYNC_INTERVAL_MINUTES=30
BACKFILL_INTERVAL_MINUTES=60
CONNECTIONS_DELTA_INTERVAL_MINUTES=15
INVITATIONS_INTERVAL_MINUTES=45
BROWSER_CONTEXT_TTL_MS=300000
BROWSER_MAX_ACTIVE_CONTEXTS=1
BROWSER_MAX_PAGES_PER_ACCOUNT=1
UNIFIED_DELTA_MAX_THREADS=1
UNIFIED_BACKFILL_MAX_THREADS=2
UNIFIED_DELTA_THREAD_LIMIT=12
UNIFIED_BACKFILL_THREAD_LIMIT=30

# Postgres password used by the docker-compose postgres service
# Generate with: openssl rand -hex 16
DB_PASSWORD=
POSTGRES_HOST_PORT=15432

# Comma-separated list of LinkedIn account IDs to run
ACCOUNT_IDS=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional proxy for all Playwright traffic
PROXY_URL=

# Optional trusted public dashboard origins for reverse proxy / Socket.IO access.
# Example: https://linkedin-console.acm.acumen-strategy.com
TRUSTED_ORIGINS=

# Optional primary dashboard origin used by the worker Socket.IO CORS policy.
# Example: https://linkedin-console.acm.acumen-strategy.com
FRONTEND_URL=

# Embedded noVNC browser used for interactive LinkedIn connect in Docker
NOVNC_PORT=6080
# Required in production. Set to the public HTTPS URL path where noVNC is
# proxied, e.g. https://your-domain.com/novnc
# The included deployment/nginx.conf proxies /novnc/ -> worker:6080 correctly.
# Leave blank to use the auto-detected default (/novnc in prod, localhost in dev).
NOVNC_PUBLIC_URL=

# Virtual display for headed Chrome inside Docker. Keep small — a larger display
# costs CPU/RAM with no benefit. Defaults match docker-compose.
XVFB_WIDTH=1366
XVFB_HEIGHT=768
XVFB_DEPTH=16
